; Engine configuration file.
config_version=5

[application]

config/name="Katrina's Game"
config/description="Medieval cliffside base-building, crafting and sword combat."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

GameState="*res://scripts/core/GameState.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[dotnet]

project/assembly_name="KatrinasGame"

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Props"
3d_physics/layer_3="Player"

[rendering]

anti_aliasing/quality/msaa_3d=2

[shader_globals]

sun_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
sun_color={
"type": "color",
"value": Color(1, 0.8, 0.6, 1)
}
night={
"type": "float",
"value": 0.0
}
